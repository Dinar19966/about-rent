datasource db { provider = "postgresql" url = env("DATABASE_URL") }
generator client { provider = "prisma-client-js" }

model Fact {
  id           String   @id @default(cuid())
  source       String
  indicator    String
  region       String
  period       String
  value        Float
  unit         String
  meta         Json?
  fetchedAt    DateTime
  publishedAt  DateTime?
  sourceUrl    String?
  checksum     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([source, indicator, region, period])
  @@index([indicator, region, period])
}

model Article {
  id           String   @id @default(cuid())
  region       String
  period       String
  template     String
  title        String
  bullets      Json     // string[]
  conclusion   String
  sliceHash    String
  sources      Json     // string[] URLs
  createdAt    DateTime @default(now())

  @@unique([region, period, sliceHash], name: "uniq_article_key")
}