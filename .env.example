# Server
PORT=3000
TZ=Europe/Prague

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/about_rent?schema=public"

# Redis (for BullMQ)
REDIS_URL="redis://localhost:6379"

# OpenRouter API
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxx
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# App settings
ARTICLE_TONE=neutral
ARTICLE_AUDIENCE=mass
DEFAULT_REGION=RU-MOW
CRON_INGEST="0 4 * * *"  # 04:00 daily
TIMEZONE=Europe/Prague